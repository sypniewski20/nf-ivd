params {
    // =====================================================
    // INPUT & ENVIRONMENT
    // =====================================================
    input_type       = 'fastq'      // fastq | bam
    samplesheet      = null
    singularity_path = null
    outfolder        = 'results'
    runID            = "${new Date().format('yyyyMMdd')}"
    pedigree         = null           // PED file for HC posteriors
    mapper           = 'bwa'     // dragmap | bwa
    // =====================================================
    // REFERENCES
    // =====================================================
    fasta            = null
    fasta_dir        = null
    bed              = null
    strat_dir        = null         // GIAB stratification beds directory
    seq_type         = 'WGS'        // WGS | WES
    calling_mode     = 'cohort'     // single | cohort
    interval_padding = 200          // WES only - for WGS always 0
    intervals_list   = null
    dragen_mode      = true
    ploidy_priors   = null
    // =====================================================
    // DEEP VARIANT
    // =====================================================

    gpus = 0

    // =====================================================
    // ANNOTATIONS
    // =====================================================
    annotate = false
    vep_cache       = null
    cache_version   = 115
    clinvar         = null
    dbnsfp          = null
    spliceai_distance = 50

    // NOTE (26.04 strict parser): the CLI no longer auto-casts --params to
    // booleans/numbers -- a flag like `--annotate false` or `--dragen_mode
    // false` now sets the param to the STRING 'false', which is truthy in
    // Groovy. Any code that reads annotate/dragen_mode/cache_version/
    // interval_padding/spliceai_distance must normalize the value at the
    // point of use, e.g. `params.annotate.toString().toBoolean()` for
    // booleans or `params.cache_version.toString().toInteger()` for numbers,
    // rather than comparing/using the raw param directly. main.nf already
    // does this for `annotate`; apply the same pattern in any subworkflow
    // that reads dragen_mode or the numeric annotation params.

    // Derived path for run logs/reports. This was previously a bare
    // top-level `def log_reports = ...` statement in the config file. The
    // strict config parser (default since 26.04) only allows config
    // assignments, config blocks, and config includes at the top level --
    // plain variable declarations must move into a block, so it's now a
    // regular params entry instead.
    log_reports = "${params.outfolder}/${params.runID}/logs"
}

// =====================================================
// PROFILES
// =====================================================
profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true

        // NOTE: as written, this always binds vep_cache/clinvar/dbnsfp even
        // when they're null (e.g. annotate = false), which would pass a
        // literal "--bind null" to singularity. Left unchanged for now since
        // it's a pre-existing behavior, not a 26.04 compatibility issue --
        // happy to make this conditional once you confirm it's in scope.
        singularity.runOptions = "--bind /dev/shm --bind ${params.vep_cache} --bind ${params.clinvar} --bind ${params.dbnsfp}"

        process {
            executor      = 'local'
            errorStrategy = 'terminate'
            maxRetries    = 1

            // Container Assignments
            withLabel: 'qc'        { container = "${params.singularity_path}/qc.sif" }
            withLabel: 'core'      { container = "${params.singularity_path}/core.sif" }
            withLabel: 'benchmark' { container = "${params.singularity_path}/happi.sif" }
            withLabel: 'manta'     { container = "${params.singularity_path}/manta.sif" }
            withLabel: 'delly'     { container = "${params.singularity_path}/delly.sif" }
            withLabel: 'cnvkit'     { container = "${params.singularity_path}/cnvkit.sif" }
            withLabel: 'vep'     { container = "${params.singularity_path}/vep115.sif" }
            withLabel: 'spliceAI'     { container = "${params.singularity_path}/spliceAI.sif" }
            withLabel: 'STR'     { container = "${params.singularity_path}/str.sif" }
            withLabel: "deepvariant" { container = "${params.singularity_path}/deepvariant.sif" }
            withLabel: 'deepvariant_gpu' {
                    container = "${params.singularity_path}/deepvariant_gpu.sif"
                    containerOptions = "--nv"
                    accelerator = 1
                } 

            // Resource Assignments
            withLabel: 'tiny'    { cpus = 1;  memory = 2.GB;   time = '1h'  }
            withLabel: 'small'   { cpus = 2;  memory = 6.GB;   time = '4h'  }
            withLabel: 'medium'  { cpus = 4;  memory = 16.GB;  time = '12h' }
            withLabel: 'large'   { cpus = 8;  memory = 32.GB;  time = '24h' }
            withLabel: 'xlarge'  { cpus = 16; memory = 64.GB;  time = '36h' }
            withLabel: 'xxlarge' { cpus = 36; memory = 128.GB; time = '48h' }
        }
    }
}

// =====================================================
// REPORTING
// =====================================================
timeline {
    enabled   = true
    file      = "${params.log_reports}/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.log_reports}/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.log_reports}/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.log_reports}/pipeline_dag.html"
    overwrite = true
}